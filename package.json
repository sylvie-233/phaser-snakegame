{
  "name": "phaser-snakegame",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "turbo run dev --filter=@snake/game",
    "build": "turbo run build",
    "preview": "turbo run preview",
    "typecheck": "turbo run typecheck",
    "dev:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Remove-Item Env:ELECTRON_RUN_AS_NODE -ErrorAction SilentlyContinue; turbo run dev --filter=@snake/game --filter=@snake/desktop\"",
    "build:win": "powershell -ExecutionPolicy Bypass -File build.ps1"
  },
  "devDependencies": {
    "turbo": "^2.10.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
